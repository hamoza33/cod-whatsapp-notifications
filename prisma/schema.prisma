generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
  UNKNOWN
  // Lead statuses (COD Network lead API codes 1-12)
  NEW
  NO_REPLY
  WRONG
  EXPIRED
  CALL_LATER
  CALL_LATER_SCHEDULED
  CANCELLED_PRICE
  DELAYED
  BLACK_LISTED
  // Order statuses (COD Network order API codes)
  ASSIGNED
  OUT_OF_STOCK
  RETURN_ON_PROCESS
}

model Order {
  id                String      @id @default(cuid())
  codNetworkOrderId String      @unique @map("cod_network_order_id")
  // Lead identifier from COD Network. Some accounts have the lead-id as the
  // primary order reference; for others it's a separate field surfaced via
  // the Webhook Lead Status events. Nullable+unique so historical orders can
  // be back-filled when a webhook eventually delivers the lead id.
  codNetworkLeadId  String?     @map("cod_network_lead_id")
  // Manually-created order — never reset by a sync from COD Network. The
  // `codNetworkOrderId` for manual orders is a generated `MANUAL-<random>`
  // string so the unique index is preserved.
  isManual          Boolean     @default(false) @map("is_manual")
  customerName      String?     @map("customer_name")
  customerPhone     String?     @map("customer_phone")
  customerCity      String?     @map("customer_city")
  customerAddress   String?     @map("customer_address")
  productName       String?     @map("product_name")
  productPrice      String?     @map("product_price")
  productQuantity   String?     @map("product_quantity")
  trackingNumber    String?     @map("tracking_number")
  deliveryCompany   String?     @map("delivery_company")
  status            OrderStatus @default(UNKNOWN)
  statusChangedAt   DateTime?   @map("status_changed_at")
  // The raw status string from COD Network (e.g. "delivered", "out for
  // delivery", "shipped") preserved verbatim for debugging / automation
  // matching. Useful when COD adds new statuses we haven't mapped yet.
  codDeliveryStatus String?     @map("cod_delivery_status")
  rawOrderJson      Json?       @map("raw_order_json")
  lastSyncedAt      DateTime?   @map("last_synced_at")
  // The `created_at` reported by COD Network for the order itself, which is
  // the meaningful "newest first" sort key (the row's own `createdAt` reflects
  // when we first synced it, not when the customer placed the order).
  codCreatedAt      DateTime?   @map("cod_created_at")
  codUpdatedAt      DateTime?   @map("cod_updated_at")
  // Set when ANY WhatsApp message has been sent for this order — used by the
  // Pipeline UI to short-circuit accidental re-sends and to render the
  // "WhatsApp Sent" virtual column.
  whatsappSentAt    DateTime?   @map("whatsapp_sent_at")
  // Whether this order has been queued for the AI voice agent to call.
  callAgentQueued   Boolean     @default(false) @map("call_agent_queued")
  // Number of call attempts made for this lead (incremented by automation/webhook).
  callAttempts      Int         @default(0) @map("call_attempts")
  // Free-form notes the operator can attach to an order from the Pipeline
  // (e.g. "called customer, no answer"). Not synced from COD Network.
  pipelineNote      String?     @map("pipeline_note")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  whatsappMessages WhatsappMessage[]
  inboundMessages  InboundMessage[]
  automationRuns   AutomationRun[]
  trackingOrders   TrackingOrder[]

  @@index([status])
  @@index([codNetworkOrderId])
  @@index([codNetworkLeadId])
  @@index([codCreatedAt])
  @@index([whatsappSentAt])
  @@map("orders")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsappMessage {
  id                    String        @id @default(cuid())
  orderId               String?       @map("order_id")
  phoneNumber           String        @map("phone_number")
  // Meta Phone Number ID (the WABA the message was sent FROM). Nullable so
  // historical rows from before multi-account support remain valid; null
  // means "sent from the default settings-level WABA".
  phoneNumberId         String?       @map("phone_number_id")
  templateName          String        @map("template_name")
  templateLanguage      String        @default("en") @map("template_language")
  templateVariablesJson Json?         @map("template_variables_json")
  headerImageUrl        String?       @map("header_image_url")
  providerMessageId     String?       @map("provider_message_id")
  status                MessageStatus @default(PENDING)
  errorMessage          String?       @map("error_message")
  sentBy                String        @default("manual") @map("sent_by")
  sentAt                DateTime?     @map("sent_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([phoneNumber])
  @@index([status])
  @@index([phoneNumberId])
  @@map("whatsapp_messages")
}

model InboundMessage {
  id                String   @id @default(cuid())
  // Meta's wamid for de-duplication; webhooks can re-deliver the same payload.
  providerMessageId String   @unique @map("provider_message_id")
  fromPhoneNumber   String   @map("from_phone_number")
  // Pre-normalized international number used to match against Order.customerPhone.
  contactName       String?  @map("contact_name")
  // "text", "image", "audio", "video", "document", "sticker", "location",
  // "contacts", "interactive", "button", "reaction", "system" — whatever Meta
  // sends. Body is stored verbatim so the inbox can render unsupported types.
  type              String
  text              String?
  mediaId           String?  @map("media_id")
  mediaMimeType     String?  @map("media_mime_type")
  // Meta Phone Number ID (the WABA the message was received ON). Nullable
  // because pre-existing inbound rows didn't store it; the inbox filter
  // treats null as "matches every account" for backward compatibility.
  phoneNumberId     String?  @map("phone_number_id")
  rawPayload        Json     @map("raw_payload")
  receivedAt        DateTime @default(now()) @map("received_at")
  orderId           String?  @map("order_id")
  order             Order?   @relation(fields: [orderId], references: [id])
  // Support source tag (e.g. "site1", "site2") detected from the WhatsApp link
  // ?source= parameter. Null for non-support or unknown-source messages.
  source            String?

  @@index([fromPhoneNumber])
  @@index([receivedAt])
  @@index([orderId])
  @@index([phoneNumberId])
  @@index([source])
  @@map("inbound_messages")
}

// Each support source represents a website/channel with its own AI system prompt.
// When a customer chats via ?source=<slug>, the matching prompt is used for auto-reply.
model SupportSource {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  systemPrompt String   @map("system_prompt") @db.Text
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("support_sources")
}

model SyncLog {
  id            String   @id @default(cuid())
  syncType      String   @map("sync_type")
  status        String
  ordersFound   Int      @default(0) @map("orders_found")
  ordersCreated Int      @default(0) @map("orders_created")
  ordersUpdated Int      @default(0) @map("orders_updated")
  messagesSent  Int      @default(0) @map("messages_sent")
  errorMessage  String?  @map("error_message")
  duration      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("sync_logs")
}

/// Cached snapshot of an approved (or rejected) WhatsApp message template
/// pulled from Meta's Graph API. Periodically refreshed by
/// `/api/whatsapp/templates/import` and surfaced in `/templates` + the Send
/// dialog so we know exactly how many body params + which header type each
/// template needs without hitting Meta on every interaction.
model WhatsappTemplate {
  id             String   @id @default(cuid())
  name           String
  language       String
  status         String
  category       String   @default("UTILITY")
  bodyParamCount Int      @default(0) @map("body_param_count")
  bodyText       String?  @map("body_text")
  headerType     String?  @map("header_type")
  components     Json
  lastFetchedAt  DateTime @default(now()) @map("last_fetched_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([name, language])
  @@index([status])
  @@map("whatsapp_templates")
}

/// A user-defined automation rule. When an order's status changes (via drag,
/// sync, or COD webhook) and matches the `whenStatusEquals` + product filters,
/// the engine optionally moves the order to `thenMoveToStatus` and/or sends
/// the configured WhatsApp template. Each (automation, order) pair runs at
/// most once when `thenSendOnce` is true.
model Automation {
  id                        String       @id @default(cuid())
  name                      String
  isEnabled                 Boolean      @default(false) @map("is_enabled")
  autoRun                   Boolean      @default(true) @map("auto_run")
  whenStatusEquals          OrderStatus? @map("when_status_equals")
  andProductContains        String?      @map("and_product_contains")
  andProductDoesNotContain  String?      @map("and_product_does_not_contain")
  thenMoveToStatus          OrderStatus? @map("then_move_to_status")
  thenSendTemplateName      String?      @map("then_send_template_name")
  thenSendTemplateLanguage  String?      @map("then_send_template_language")
  // Ordered list of variable mappings — one entry per body param in the
  // WhatsApp template. Each entry is either a literal string (e.g. "Hello")
  // or a token like `{customer_name}`, `{phone}`, `{product}`, `{price}`,
  // `{quantity}`, `{tracking}`, `{order_id}`, `{lead_id}`, `{city}`,
  // `{tracking_status}`. The
  // sender resolves the tokens against the order being processed.
  thenSendTemplateVariables Json?        @map("then_send_template_variables")
  // Optional header image URL — used when the template has an IMAGE header.
  // If null, the per-Settings default header image URL is used.
  thenSendHeaderImageUrl    String?      @map("then_send_header_image_url")
  thenSendOnce              Boolean      @default(true) @map("then_send_once")
  // --- Advanced conditions ---
  // Phone number prefix / pattern match (e.g. "+212", "06", "07").
  // If set, the automation only fires when the order's phone starts with this value.
  andPhoneStartsWith        String?      @map("and_phone_starts_with")
  // Tracking number condition — when set to "exists", the automation only fires
  // when a tracking number is present on the order; "not_exists" fires only when
  // the tracking number is absent.
  andTrackingCondition      String?      @map("and_tracking_condition")
  // City-based filter — if set, order's city must contain this substring.
  andCityContains           String?      @map("and_city_contains")
  // Customer name filter — if set, order's customer name must contain this substring.
  andCustomerNameContains   String?      @map("and_customer_name_contains")
  // Minimum order price filter (as a string to match COD Network's format).
  andMinPrice               String?      @map("and_min_price")
  // Maximum order price filter.
  andMaxPrice               String?      @map("and_max_price")
  // Tracking status filter — if set, the latest tracking event description
  // must contain this substring for the automation to fire. Enables rules
  // like "when tracking status contains 'location changed' → send template".
  andTrackingStatusContains String?      @map("and_tracking_status_contains")
  // Call attempts conditions — fire only when the order's callAttempts
  // is >= min and/or <= max. Enables rules like "after 4 calls, send template".
  andMinCallAttempts        Int?         @map("and_min_call_attempts")
  andMaxCallAttempts        Int?         @map("and_max_call_attempts")
  // Time-based scheduling — if set, the automation action is deferred until
  // this hour (0-23, UTC). E.g. "6" means the template is sent at 6:00 AM.
  scheduledSendHour         Int?         @map("scheduled_send_hour")
  // Whether to increment call attempts counter when this automation fires.
  incrementCallAttempts     Boolean      @default(false) @map("increment_call_attempts")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  runs AutomationRun[]

  @@index([isEnabled])
  @@map("automations")
}

/// One row per (automation, order) execution attempt. Acts as the de-dupe
/// key for `thenSendOnce` and also surfaces a per-automation activity feed
/// in the UI.
model AutomationRun {
  id              String   @id @default(cuid())
  automationId    String   @map("automation_id")
  orderId         String   @map("order_id")
  status          String
  movedFromStatus String?  @map("moved_from_status")
  movedToStatus   String?  @map("moved_to_status")
  sentMessage     Boolean  @default(false) @map("sent_message")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([automationId, orderId])
  @@index([orderId])
  @@map("automation_runs")
}

/// A visual-builder automation flow — the newer, more flexible counterpart
/// to `Automation`. Each flow is a directed graph of nodes (triggers,
/// conditions, actions) connected by edges. The graph definition is stored
/// as a JSON blob (`graphJson`) so the schema can evolve without migrations
/// every time a new node type is added.
///
/// Flows fire on the trigger declared by their entry-node `triggerType` and
/// execute end-to-end through the graph until they hit an action with no
/// outgoing edge or an explicit `action.stop` node. Each execution attempt
/// is recorded as an `AutomationFlowRun` row.
model AutomationFlow {
  id          String    @id @default(cuid())
  name        String
  description String?
  isEnabled   Boolean   @default(false) @map("is_enabled")
  /// One of: ORDER_CREATED, ORDER_STATUS_CHANGED, TRACKING_STATUS_CHANGED,
  /// MESSAGE_RECEIVED, MANUAL. Used by the engine to know which event
  /// streams should evaluate this flow without parsing the JSON graph.
  triggerType String    @map("trigger_type")
  /// Full graph definition: `{ nodes: [...], edges: [...], viewport: {...} }`
  /// Matches the @xyflow/react shape so the canvas can hydrate directly.
  graphJson   Json      @map("graph_json")
  lastFiredAt DateTime? @map("last_fired_at")
  runCount    Int       @default(0) @map("run_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  runs AutomationFlowRun[]

  @@index([isEnabled, triggerType])
  @@map("automation_flows")
}

/// One execution attempt of an AutomationFlow. Records which path the
/// engine walked through the graph + every action that ran, so the UI
/// can render a step-by-step timeline and the operator can debug why a
/// flow stopped where it did.
model AutomationFlowRun {
  id           String    @id @default(cuid())
  flowId       String    @map("flow_id")
  orderId      String?   @map("order_id")
  /// Free-form initial context — the order snapshot, tracking snapshot,
  /// inbound message text, etc. — captured at the moment the trigger fired.
  contextJson  Json      @map("context_json")
  /// RUNNING, SUCCESS, FAILED, STOPPED
  status       String
  /// Per-node execution log:
  /// `[{ nodeId, nodeType, status, output?, error?, ranAt }]`
  stepsJson    Json      @map("steps_json")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  flow  AutomationFlow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  waits AutomationFlowWait[]

  @@index([flowId, startedAt])
  @@index([orderId])
  @@map("automation_flow_runs")
}

/// A paused execution of an AutomationFlow that's blocked on a customer
/// reply. Created when the engine reaches a `wait_for_reply` action node;
/// matched (or expired) by the WhatsApp webhook when the next inbound
/// message from `fromPhone` arrives, at which point the engine resumes
/// the flow from the matched branch.
model AutomationFlowWait {
  id                 String    @id @default(cuid())
  runId              String    @map("run_id")
  flowId             String    @map("flow_id")
  orderId            String?   @map("order_id")
  /// Normalized E.164 phone number we're waiting on a reply from.
  fromPhone          String    @map("from_phone")
  /// Node id of the `wait_for_reply` action node that paused the run.
  waitingNodeId      String    @map("waiting_node_id")
  /// Serialized FlowExecutionContext at the time of the pause. Reused
  /// verbatim when the run resumes — we deliberately don't refetch order
  /// state so the resume reflects the moment the customer was asked.
  contextJson        Json      @map("context_json")
  /// Cumulative `stepsJson` snapshot at pause time. We append further
  /// steps to this array on resume and write the merged log back onto
  /// AutomationFlowRun.stepsJson.
  stepsJson          Json      @map("steps_json")
  /// Comma-separated keyword lists copied from the wait_for_reply node,
  /// so a later schema change to the flow graph doesn't break parked
  /// runs that were created before the edit.
  yesKeywords        String    @default("") @map("yes_keywords")
  noKeywords         String    @default("") @map("no_keywords")
  expiresAt          DateTime  @map("expires_at")
  /// WAITING, MATCHED, EXPIRED, CANCELLED
  status             String    @default("WAITING")
  matchedHandle      String?   @map("matched_handle")
  matchedAt          DateTime? @map("matched_at")
  matchedMessageText String?   @map("matched_message_text")
  createdAt          DateTime  @default(now()) @map("created_at")

  run AutomationFlowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([fromPhone, status])
  @@index([flowId])
  @@index([status, expiresAt])
  @@map("automation_flow_waits")
}

/// Cached catalog of products pulled from COD Network's seller API
/// (`GET /v2/seller/products`). Refreshed by the sync cron + on-demand via
/// `/api/products/sync`. Surfaced in the Automation editor so the operator
/// can pick products by name/SKU when writing rules (cleaner than typing a
/// substring) and in the Manual Order form so they can autocomplete the
/// product fields.
model Product {
  id                  String   @id @default(cuid())
  codNetworkProductId String   @unique @map("cod_network_product_id")
  sku                 String?
  name                String
  nameArabic          String?  @map("name_arabic")
  imageUrl            String?  @map("image_url")
  description         String?  @map("description")
  // String to preserve currency precision (COD returns e.g. "199.00").
  price               String?
  currency            String?
  // From COD type.label — e.g. "Gadget", "Beauty", etc.
  productType         String?  @map("product_type")
  // From COD status.label — e.g. "Enabled", "Disabled".
  productStatus       String?  @map("product_status")
  // Whether this is a COD Drop product (vs seller's own product).
  isDropProduct       Boolean  @default(false) @map("is_drop_product")
  // Whether the AI agent is enabled for this product specifically.
  aiAgentEnabled      Boolean  @default(false) @map("ai_agent_enabled")
  // Direct link to the seller's landing page for the product (from COD).
  storeUrl            String?  @map("store_url")
  rawProductJson      Json?    @map("raw_product_json")
  lastSyncedAt        DateTime @default(now()) @map("last_synced_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([sku])
  @@map("products")
}

/// Multiple WhatsApp Business numbers can be managed via the Settings UI.
/// The operator picks which number to use in the Inbox dropdown.
model WhatsappNumber {
  id            String   @id @default(cuid())
  label         String
  phoneNumberId String   @map("phone_number_id")
  displayPhone  String   @map("display_phone")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_numbers")
}

enum TrackingCarrier {
  IMILE
  INJAZ
  JTE
  JDW
  NAQEL
  OTHER
}

enum TrackingStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  EXCEPTION
  UNKNOWN
  EXPIRED
}

/// A package being tracked via iMile or Injaz Express. Tracking numbers
/// starting with "60" are routed to iMile; those starting with "INJAZ."
/// are routed to Injaz Express. The cron job refreshes all active
/// (non-delivered, non-returned) packages every 30 minutes.
model TrackingOrder {
  id             String          @id @default(cuid())
  trackingNumber String          @unique @map("tracking_number")
  carrier        TrackingCarrier
  carrierName    String?         @map("carrier_name")
  status         TrackingStatus  @default(PENDING)
  latestEvent    String?         @map("latest_event")
  latestEventAt  DateTime?       @map("latest_event_at")
  latestError    String?         @map("latest_error")
  customerName   String?         @map("customer_name")
  customerPhone  String?         @map("customer_phone")
  productName    String?         @map("product_name")
  codCreatedAt   DateTime?       @map("cod_created_at")
  orderId        String?         @map("order_id")
  order          Order?          @relation(fields: [orderId], references: [id])
  lastCheckedAt  DateTime?       @map("last_checked_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  events TrackingEvent[]

  @@index([carrier])
  @@index([status])
  @@index([orderId])
  @@map("tracking_orders")
}

/// Individual status update for a tracked package. Each refresh appends
/// new events that haven't been seen yet (de-duped by content + timestamp).
model TrackingEvent {
  id              String        @id @default(cuid())
  trackingOrderId String        @map("tracking_order_id")
  trackingOrder   TrackingOrder @relation(fields: [trackingOrderId], references: [id], onDelete: Cascade)
  status          String
  description     String
  location        String?
  occurredAt      DateTime      @map("occurred_at")
  rawData         Json?         @map("raw_data")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([trackingOrderId, description, occurredAt])
  @@index([trackingOrderId])
  @@index([occurredAt])
  @@map("tracking_events")
}

/// Stored images for template headers — avoids re-pasting URLs every time.
model ImageLibrary {
  id        String   @id @default(cuid())
  url       String
  name      String
  mediaId   String?  @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("image_library")
}

/// Tracks which conversations are pinned in the inbox.
model PinnedConversation {
  id          String   @id @default(cuid())
  phoneNumber String   @unique @map("phone_number")
  pinnedAt    DateTime @default(now()) @map("pinned_at")

  @@map("pinned_conversations")
}

/// Tracks when a user last read a conversation (by phone number).
/// Used to compute unread counts: messages received after lastReadAt are unread.
model ConversationReadState {
  id          String   @id @default(cuid())
  phoneNumber String   @unique @map("phone_number")
  lastReadAt  DateTime @map("last_read_at")

  @@map("conversation_read_states")
}

enum BulkCampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum BulkRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
  CANCELLED
}

/// A bulk WhatsApp message campaign. The operator uploads a sheet of
/// recipients, maps columns to template variables, and the in-process
/// worker sends one row at a time at a throttled rate while updating each
/// `BulkRecipient` with sent / delivered / read / failed status.
model BulkCampaign {
  id                 String             @id @default(cuid())
  name               String
  templateName       String             @map("template_name")
  templateLanguage   String             @map("template_language")
  /// Snapshot of the body-param count from the chosen template (used to
  /// validate per-recipient variable arrays before send and to render the
  /// status table without re-fetching the template each time).
  bodyParamCount     Int                @default(0) @map("body_param_count")
  /// Optional header value — for IMAGE headers either an https URL or a
  /// Meta media ID (set `headerKind` accordingly). For TEXT headers, the
  /// literal text. Same shape as the Pipeline Send dialog.
  headerType         String?            @map("header_type")
  headerValue        String?            @map("header_value")
  headerKind         String?            @map("header_kind")
  /// WABA Phone Number ID to send from. Null means "use the default
  /// settings-level WhatsApp account".
  phoneNumberId      String?            @map("phone_number_id")
  /// Audit copy of the operator's column-mapping decision. Shape:
  /// `{ phoneColumn: string, nameColumn: string|null,
  ///    variableColumns: Array<{column: string|null, literal: string|null}> }`.
  columnMappingJson  Json?              @map("column_mapping_json")
  status             BulkCampaignStatus @default(DRAFT)
  totalRecipients    Int                @default(0) @map("total_recipients")
  /// Default country code applied during phone normalization for this
  /// campaign (frozen at creation time so re-running a campaign uses the
  /// same rules even if the global default later changes).
  defaultCountryCode String             @default("212") @map("default_country_code")
  /// Per-row delay in milliseconds the worker waits between sends. Allows
  /// the operator to dial throughput down if Meta starts rate-limiting.
  throttleMs         Int                @default(200) @map("throttle_ms")
  /// Optional limit on attempts per recipient when a transient error
  /// occurs (network / 5xx). One past this and the recipient is marked
  /// FAILED for good.
  maxAttempts        Int                @default(3) @map("max_attempts")
  errorMessage       String?            @map("error_message")
  startedAt          DateTime?          @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  createdBy          String             @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  recipients BulkRecipient[]

  @@index([status])
  @@index([createdAt])
  @@map("bulk_campaigns")
}

/// One row in a `BulkCampaign`. Holds the resolved phone + variables + any
/// per-recipient send error. Status mirrors `WhatsappMessage.status` and is
/// updated by both the send-worker and the inbound webhook (which receives
/// Meta's delivery / read receipts).
model BulkRecipient {
  id                String              @id @default(cuid())
  campaignId        String              @map("campaign_id")
  rowIndex          Int                 @map("row_index")
  phoneNumber       String              @map("phone_number")
  phoneNumberRaw    String?             @map("phone_number_raw")
  displayName       String?             @map("display_name")
  /// Ordered list of resolved body-variable strings (length should equal
  /// the campaign's bodyParamCount). Missing source values are coerced to
  /// the empty string per the "missing variables OK" UX rule.
  variablesJson     Json                @map("variables_json")
  /// Optional per-row header value (e.g. tracking URL inserted into a
  /// header image link). When null, the campaign-level header is used.
  headerValue       String?             @map("header_value")
  status            BulkRecipientStatus @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  whatsappMessageId String?             @map("whatsapp_message_id")
  errorMessage      String?             @map("error_message")
  errorCode         String?             @map("error_code")
  attemptCount      Int                 @default(0) @map("attempt_count")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  readAt            DateTime?           @map("read_at")
  failedAt          DateTime?           @map("failed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  campaign BulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([providerMessageId])
  @@map("bulk_recipients")
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String   @map("mime_type")
  size        Int
  url         String
  metaMediaId String?  @map("meta_media_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("media_assets")
}
