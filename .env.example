# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cod_whatsapp"

# NextAuth
NEXTAUTH_SECRET="generate-a-secure-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# COD Network API
COD_NETWORK_API_BASE_URL="https://api.cod.network/v2"
COD_NETWORK_API_TOKEN="your-cod-network-api-token"

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_API_VERSION="v17.0"

# Cron job secret (used to authenticate cron API calls)
CRON_SECRET="generate-a-secure-secret-here"
