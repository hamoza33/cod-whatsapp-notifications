# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cod_whatsapp"

# NextAuth
NEXTAUTH_SECRET="generate-a-secure-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# COD Network API
COD_NETWORK_API_BASE_URL="https://api.cod.network/v2"
# Recommended: email + password (per COD Network docs). Yields a 1-hour
# access_token from POST /v2/seller/login that the app refreshes automatically.
COD_NETWORK_API_EMAIL="you@example.com"
COD_NETWORK_API_PASSWORD="your-cod-network-password"
# Legacy fallback: a long-lived token from the seller portal. Prefer the
# email/password flow above — portal-issued tokens are often rejected by the
# API.
COD_NETWORK_API_TOKEN="your-cod-network-api-token"

# WhatsApp Cloud API
# IMPORTANT: WHATSAPP_PHONE_NUMBER_ID is the 15–16 digit Meta-issued ID from
# WhatsApp Manager → API Setup → Phone numbers, NOT your visible phone number.
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_API_VERSION="v17.0"
# Approved template name + language code used for the Test Message button and
# automated sends.
WHATSAPP_TEMPLATE_NAME="order_out_for_delivery"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Cron job secret (used to authenticate cron API calls)
CRON_SECRET="generate-a-secure-secret-here"
